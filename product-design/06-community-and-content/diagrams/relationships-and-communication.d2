# Selected projection of PD-027/028/029. Access exceptions remain deferred.
direction: down
following: "Approved following A → B\nB explicitly accepts\nNo mutual follow required" {class: core}
guidance: "Established guidance\nPrimary / Journey modes preserved\nNo following prerequisite" {class: process}
conversation: "Private conversation A ↔ B\nBoth may initiate; one per pair\nNot automatically Journey history" {class: platform}
audience: "B's Followers audience\nMay include A\nNo reciprocal audience grant" {class: growth}
following -> conversation: "permits communication" {class: progression}
guidance -> conversation: "independently permits" {class: progression}
following -> audience: "direction matters" {class: support}
