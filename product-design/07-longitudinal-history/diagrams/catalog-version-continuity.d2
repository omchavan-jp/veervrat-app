# Map: PD-034/035 projection; old meaning is preserved, new practice uses current non-retired meaning.
direction: down
identity: "Underlying विधान identity\nAt most one unconcluded Journey\nAcross all semantic versions" {class: core}
old: "Earlier semantic version" {class: process}
current: "Current semantic version\nIf विधान is not retired" {class: growth}
assessment: "Historical assessment\nEarlier version and responses retained" {class: platform}
existing: "Existing Journey\nOriginal objective retained\nNo automatic migration" {class: platform}
new: "Consciously initiated new Journey\nCurrent meaning\nChange awareness; no reassessment gate" {class: platform}
identity -> old: "same underlying identity" {class: support}
identity -> current: "meaningful new version" {class: support}
old -> assessment: "historical context" {class: support}
old -> existing: "retains its anchor" {class: progression}
current -> new: "current practice objective" {class: progression}
assessment -> new: "may be discovery context\nDoes not control the objective" {class: support}
