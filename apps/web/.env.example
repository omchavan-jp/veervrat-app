# Per-environment config, read at RUNTIME (apps/web/lib/runtime-config.ts).
#
# Deliberately NOT NEXT_PUBLIC_*. Those are inlined into the browser bundle at build time, and
# CD promotes one web image from UAT to production unchanged — so a NEXT_PUBLIC_ value would
# carry UAT's settings into prod. That is not hypothetical; it shipped once, and prod's web
# tier called UAT's api. See documentation/21_Infrastructure-Conventions.md §17.

# Absolute base URL of the api, including the /api/v1 prefix. The browser calls the api
# directly — there is no same-origin proxy any more.
API_BASE_URL="http://localhost:3001/api/v1"

# Absolute origin this app is served from; used for canonical and og: URLs.
SITE_URL="http://localhost:3000"

# Beta feedback widget for the environment as a whole: "test" (list + form), "public"
# (form only), "off"/unset = hidden. Which *users* see it is per-user data, not config (D20).
# FEEDBACK_MODE="test"

# ── Build-time, and deliberately so ───────────────────────────────────────────────────────
# In-context content editor (dev-only tooling). Still NEXT_PUBLIC_ on purpose: being inlined
# lets the bundler drop the editor's code entirely, so it never ships to users. Making it
# runtime config would put that code in the production bundle behind a flag — a security
# change, not a refactor. See B1.
# NEXT_PUBLIC_CONTENT_EDIT="on"
