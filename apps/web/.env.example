# API URL (NestJS backend)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# In-context content editor (dev-only). "on" enables it; unset/anything else = off.
# Only set on the separate content-edit deployment — never in production.
# NEXT_PUBLIC_CONTENT_EDIT="on"

# Beta feedback widget: "test" (list + form, all authenticated users), "public"
# (form only), unset = hidden.
# NEXT_PUBLIC_FEEDBACK_MODE="test"
