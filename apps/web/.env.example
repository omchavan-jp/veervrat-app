# Per-environment config, read at RUNTIME (apps/web/lib/runtime-config.ts).
#
# Deliberately NOT NEXT_PUBLIC_*. Those are inlined into the browser bundle at build time, and
# Environment-specific NEXT_PUBLIC_ values can be baked into a reused image.
# Production currently rebuilds on a prod-* tag, despite the intended promotion
# invariant. The runtime-config rule remains necessary. A baked UAT value once made prod's web
# tier called UAT's api. See documentation/21_Infrastructure-Conventions.md §17.

# Absolute base URL of the api, including the /api/v1 prefix. The browser calls the api
# directly — there is no same-origin proxy any more.
API_BASE_URL="http://localhost:3001/api/v1"

# Absolute origin this app is served from; used for canonical and og: URLs.
SITE_URL="http://localhost:3000"

# Internal product-design renderer origin, including scheme but no path. Set this
# only when running the separate renderer locally. The web gateway checks the
# API's PRODUCT_DOCS_VIEW grant on every /product-docs request.
PRODUCT_DOCS_MODE="off" # off | granted; production is forced off
# PRODUCT_DOCS_INTERNAL_URL="http://localhost:3002"

# Beta feedback widget: off/unset hides it, granted requires FEEDBACK_WIDGET.
# FEEDBACK_MODE="off"

# In-context content editor is gated at runtime, not by NEXT_PUBLIC_*.
# CONTENT_EDIT_ENABLED="true"   # does the feature exist here
# The user must also hold CONTENT_EDIT, granted from /admin/users/[id].
