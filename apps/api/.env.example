# ─── Database ───────────────────────────────────────
DATABASE_URL="postgresql://veervrat:veervrat_local@localhost:5433/veervrat?schema=public"

# ─── Server ─────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ─── Session ────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME="veervrat_session"

# CSRF (double-submit cookie)
CSRF_COOKIE_NAME="veervrat_csrf"

# ─── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# ─── Redis ───────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Meilisearch ─────────────────────────────────────
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="veervrat_meili_local"

# ─── MinIO (S3-compatible) ───────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="veervrat-uploads"
S3_ACCESS_KEY="veervrat"
S3_SECRET_KEY="veervrat_local"

# ─── Email ───────────────────────────────────────────
# Not needed for local dev — emails are logged to console
# RESEND_API_KEY="re_your_api_key"
# EMAIL_FROM="Veervrat <noreply@yourdomain.com>"

# ─── Error tracking ──────────────────────────────────
# GLITCHTIP_DSN="https://your-dsn@glitchtip.instance/1"
