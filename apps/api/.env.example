# ─── Database ───────────────────────────────────────
DATABASE_URL="postgresql://veervrat:veervrat_local@localhost:5433/veervrat?schema=public"

# Max pg connections held by ONE replica (default 10). Size it against the server, not the app:
#   DATABASE_POOL_MAX × maxReplicas + headroom (migrations, admin tools) ≤ server max_connections
# Managed Postgres — Azure Flexible Server on Burstable especially — allows fewer connections
# than a few replicas will open by default. Exhaustion is a cliff: every request fails at once,
# health probes included, so the platform cannot recover the service on its own.
# DATABASE_POOL_MAX=10

# ─── Server ─────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Upper bound on graceful shutdown (default 10000). Must stay comfortably under the platform's
# SIGTERM→SIGKILL grace period, so a hung shutdown handler can't hold the container open.
# SHUTDOWN_TIMEOUT_MS=10000

# ─── Session ────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME="veervrat_session"

# CSRF (double-submit cookie)
CSRF_COOKIE_NAME="veervrat_csrf"

# ─── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# ─── Redis ───────────────────────────────────────────
# Required in any multi-replica deployment. When unset the API still boots, but rate limits
# fall back to per-process counters and Socket.IO to the in-memory adapter — both correct for
# a single process, both silently wrong with more than one replica.
REDIS_URL="redis://localhost:6380"

# ─── Meilisearch ─────────────────────────────────────
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="veervrat_meili_local"

# ─── MinIO (S3-compatible) ───────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="veervrat-uploads"
S3_ACCESS_KEY="veervrat"
S3_SECRET_KEY="veervrat_local"

# ─── Email ───────────────────────────────────────────
# Not needed for local dev — emails are logged to console
# EMAIL_FROM="Veervrat <noreply@yourdomain.com>"

# ─── Error tracking ──────────────────────────────────
# GLITCHTIP_DSN="https://your-dsn@glitchtip.instance/1"

# ─── In-context content editor (dev-only tooling; off by default) ────
# Only set on the separate content-edit deployment — never in production.
# CONTENT_EDIT_ENABLED="false"
# CONTENT_EDITOR_USER_IDS="uuid-1,uuid-2"
# CONTENT_EDIT_GITHUB_TOKEN="github_pat_..."
# CONTENT_EDIT_GITHUB_REPO="veer-vrat/veervrat-app"
# CONTENT_EDIT_GITHUB_BASE_BRANCH="dev"

# Outbound email — JP IT's SMTP relay (D9). Leave unset locally: with no SMTP_HOST the
# EmailService logs messages to the console instead of sending, so dev needs no credentials.
# ⚠️ Port 587 means STARTTLS, so SMTP_SECURE stays false. true would mean implicit TLS on 465
# and fails against this relay with an opaque handshake error.
# SMTP_HOST="dhoomketu.in"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="do-not-reply-veervrat@notifications.jnanaprabodhini.org"
# SMTP_PASS="<from Key Vault — never commit>"
# EMAIL_FROM="Veervrat <do-not-reply-veervrat@notifications.jnanaprabodhini.org>"
