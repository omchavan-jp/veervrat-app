# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://veervrat:veervrat_local@localhost:5433/veervrat?schema=public"

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Session
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME="veervrat_session"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Email (not needed for local dev — emails are logged to console)
# RESEND_API_KEY="re_your_api_key"
# EMAIL_FROM="Veervrat <noreply@yourdomain.com>"
