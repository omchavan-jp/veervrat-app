// Editable, admin-managed explanatory copy rendered in the UI (modals, intros), keyed by a
// stable string. Bodies are Tiptap JSON ASTs.
model CmsPage {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  // Bumped deliberately by an administrator when a change is material, not automatically on
  // every edit — otherwise correcting a typo re-prompts every user for consent. Judging
  // materiality is a human decision and should stay one. Only the policy documents use it
  // meaningfully; other pages leave it at 1.
  version     Int      @default(1)
  titleEn     String   @map("title_en")
  titleMr     String?  @map("title_mr")
  bodyEn      Json     @map("body_en")
  bodyMr      Json?    @map("body_mr")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

// ═══════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════

model Notification {
