  // a foreign key on vm_id and none on vratarthi_id — one side was enforced and the other was
  // not. Also what lets a vratmitra's roster fetch its people in one query.
  vratarthi User @relation("GlobalVratarthi", fields: [vratarthiId], references: [id])

