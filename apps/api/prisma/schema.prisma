generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════

enum Role {
  VRATARTHI  @map("vratarthi")
  VRATMITRA  @map("vratmitra")
  MODERATOR  @map("moderator")
  ADMIN      @map("admin")

  @@map("role")
}

// What a person may *try*, as opposed to who they *are* (Role).
//
// Deliberately separate from Role: a person is a vratarthi AND a beta tester AND a content
// editor at once, and roles are not additive in that way without becoming a bag. Adding
// BETA_TESTER to Role would leak it into every switch that reasons about domain identity —
// journey visibility, vratmitra relationships, moderation — none of which care.
//
// Feature-scoped, not person-scoped. A person-scoped BETA_TESTER would silently change meaning
// each time a feature joined it, leaving audit rows that record a grant whose consequences
// drifted after the fact.
enum Capability {
  FEEDBACK_WIDGET  @map("feedback_widget")
  CONTENT_EDIT     @map("content_edit")
  CONTENT_SUGGEST  @map("content_suggest")

  @@map("capability")
}

enum Language {
  EN @map("en")
  MR @map("mr")

  @@map("language")
}

enum AuthProvider {
  EMAIL  @map("email")
  GOOGLE @map("google")

  @@map("auth_provider")
}

enum VerificationType {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")
  EMAIL_CHANGE       @map("email_change")
  GOOGLE_LINK        @map("google_link")

  @@map("verification_type")
}

enum JourneyState {
  NOT_STARTED @map("not_started")
  ACTIVE      @map("active")
  PAUSED      @map("paused")
  DORMANT     @map("dormant")
  COMPLETED   @map("completed")

  @@map("journey_state")
}

enum ErcStatus {
  NOT_STARTED @map("not_started")
  IN_PROGRESS @map("in_progress")
  SUBMITTED   @map("submitted")
  APPROVED    @map("approved")
  REVISIT     @map("revisit")

  @@map("erc_status")
}

enum ExposureTier {
  LOCAL         @map("local")
  NATIONAL      @map("national")
  INTERNATIONAL @map("international")

  @@map("exposure_tier")
}

enum InvitationType {
  PLATFORM   @map("platform")
  VM_GLOBAL  @map("vm_global")
  VM_JOURNEY @map("vm_journey")

  @@map("invitation_type")
}

enum InvitationStatus {
  PENDING   @map("pending")
  ACCEPTED  @map("accepted")
  DECLINED  @map("declined")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")

  @@map("invitation_status")
}

enum InvitationChannel {
  IN_APP   @map("in_app")
  EMAIL    @map("email")
  EXTERNAL @map("external")

  @@map("invitation_channel")
}

enum VmRelationshipState {
  PENDING @map("pending")
  ACTIVE  @map("active")
  ENDED   @map("ended")

  @@map("vm_relationship_state")
}

enum CheckinStatus {
  DONE    @map("done")
  PARTIAL @map("partial")
  MISSED  @map("missed")

  @@map("checkin_status")
}

enum UploadPurpose {
  CHAT       @map("chat")
  EXPERIENCE @map("experience")
  BLOG       @map("blog")

  @@map("upload_purpose")
}

enum ExperienceVisibility {
  ONLY_ME @map("only_me")
  FRIENDS @map("friends")
  PUBLIC  @map("public")

  @@map("experience_visibility")
}

enum ErcEntityType {
  EXPOSURE   @map("exposure")
  RESOLUTION @map("resolution")
  CHALLENGE  @map("challenge")

  @@map("erc_entity_type")
}

enum ResourceType {
  FILE @map("file")
  LINK @map("link")

  @@map("resource_type")
}

enum TagEntityType {
  VIRTUE     @map("virtue")
  SUBVIRTUE  @map("subvirtue")
  WEAKNESS   @map("weakness")
  SENTENCE   @map("sentence")
  EXPOSURE   @map("exposure")
  RESOLUTION @map("resolution")
  CHALLENGE  @map("challenge")
  JOURNEY    @map("journey")

  @@map("tag_entity_type")
}

enum NotificationEventType {
  VM_INVITATION_RECEIVED       @map("vm_invitation_received")
  VM_INVITATION_ACCEPTED       @map("vm_invitation_accepted")
  VM_INVITATION_DECLINED       @map("vm_invitation_declined")
  VM_INVITATION_EXPIRED        @map("vm_invitation_expired")
  INVITEE_JOINED_PLATFORM      @map("invitee_joined_platform")
  JOURNEY_DORMANT              @map("journey_dormant")
  NEW_ERC_AVAILABLE            @map("new_erc_available")
  ERC_CLOSURE_SUBMITTED        @map("erc_closure_submitted")
  ERC_CLOSURE_APPROVED         @map("erc_closure_approved")
  ERC_RETURNED_FOR_REVISIT     @map("erc_returned_for_revisit")
  JOURNEY_COMPLETION_SUBMITTED @map("journey_completion_submitted")
  JOURNEY_COMPLETION_APPROVED  @map("journey_completion_approved")
  CUSTOM_ERC_REVIEW_REQUESTED  @map("custom_erc_review_requested")
  CUSTOM_ERC_APPROVED          @map("custom_erc_approved")
  CUSTOM_ERC_REJECTED          @map("custom_erc_rejected")
  VM_SUGGESTION_NEW            @map("vm_suggestion_new")
  VM_SUGGESTION_DISMISSED      @map("vm_suggestion_dismissed")
  BLOG_COMMENT_NEW             @map("blog_comment_new")
  COMMENT_REPORTED             @map("comment_reported")
  NEW_FOLLOWER                 @map("new_follower")
  CHAT_MESSAGE_RECEIVED        @map("chat_message_received")
  VM_WITHDREW                  @map("vm_withdrew")

  @@map("notification_event_type")
}

enum FeedbackType {
  ISSUE        @map("issue")
  IMPROVEMENT  @map("improvement")
  MODIFICATION @map("modification")
  ADDITION     @map("addition")

  @@map("feedback_type")
}

enum FeedbackStatus {
  NEW      @map("new")
  TRIAGED  @map("triaged")
  DONE     @map("done")
  DECLINED @map("declined")

  @@map("feedback_status")
}

// ═══════════════════════════════════════════════════
// IDENTITY & AUTH
// ═══════════════════════════════════════════════════

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  displayName           String    @map("display_name")
  username              String    @unique
  avatarUrl             String?   @map("avatar_url")
  gender                String?
  // Required, and validated as 18+ at account creation. Stored as a date rather than a computed
  // age: age changes and dates do not, and a derived value that silently goes stale is worse
  // than storing nothing. NEVER returned by the public profile API — a date of birth is an
  // identity-verification token used by banks and government services.
  // Nullable ONLY so anonymisation can clear it — an account that no longer belongs to anyone
  // has no date of birth, and keeping one after deletion is retention with no purpose behind it
  // (#140). Creation still always supplies it: `AuthRepository.createUser` takes a non-optional
  // `dob`, and the 18+ gate runs before any create. The database no longer enforces presence;
  // the single creation path does.
  dob                   DateTime? @db.Date
  language              Language  @default(EN)
  emailVerifiedAt       DateTime? @map("email_verified_at")
  accountSetupCompletedAt DateTime? @map("account_setup_completed_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  // Set when the user asks to replay the contextual UI walkthrough ("Restart tour", spec/26
  // §5). Does NOT reset onboardingCompletedAt — the account-setup gate stays satisfied.
  tourResetAt           DateTime? @map("tour_reset_at")
  lastActiveAt          DateTime? @map("last_active_at")
  showLastActive        Boolean   @default(true) @map("show_last_active")
  showOnlineIndicator   Boolean   @default(true) @map("show_online_indicator")
  profilePrivate        Boolean   @default(false) @map("profile_private")
  // Per-field public-profile visibility (spec/10). Empty/missing key = visible
  // (all fields public by default). Only `false` entries hide a field.
  profileVisibility     Json      @default("{}") @map("profile_visibility")
  // Per-event email opt-out map (spec/25). Missing key = email enabled; only explicit
  // `false` opts out. Storage-only until notification email delivery is built.
  notificationPrefs     Json      @default("{}") @map("notification_prefs")
  // Address awaiting confirmation during an email-change flow (null when none pending).
  pendingEmail          String?   @map("pending_email")
  suspendedAt           DateTime? @map("suspended_at")
  anonymisedAt          DateTime? @map("anonymised_at")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  roles              UserRole[]
  capabilities       UserCapability[]
  consents           UserConsent[]
  authAccounts       AuthAccount[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  invitationsSent    Invitation[]          @relation("InvitationSender")
  followers          UserFollow[]          @relation("Following")
  following          UserFollow[]          @relation("Follower")
  notifications      Notification[]        @relation("NotificationRecipient")
  actorNotifications Notification[]        @relation("NotificationActor")
  journeys           Journey[]             @relation("VratarthiJourneys")
  testAttempts       TestAttempt[]
  globalVmFor        VmRelationship[]      @relation("GlobalVM")
  // The mirror of globalVmFor: relationships in which this user is the vratarthi.
  globalVratmitraOf  VmRelationship[]      @relation("GlobalVratarthi")
  journeyVmFor       JourneyVmAssignment[] @relation("JourneyVM")
  experienceLogs     ExperienceLog[]
  blogs              Blog[]
  blogComments       BlogComment[]
  auditEvents        AuditEvent[]          @relation("AuditActor")
  chatMessages       ChatMessage[]
  uploads            Upload[]
  feedbackItems      FeedbackItem[]        @relation("FeedbackReporter")
  feedbackUpvotes    FeedbackUpvote[]      @relation("FeedbackUpvoter")

  @@index([username])
  @@index([email])
  @@map("users")

  contentSuggestions ContentSuggestion[] @relation("SuggestionAuthor")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// Per-user feature access, managed from the admin dashboard rather than environment config.
//
// grantedBy is on the row, not only in the audit log, so the *current state* answers "who gave
// this to them?" without a log search. It is intentionally not a foreign key with a cascade:
// deleting the granting admin must not erase the record of who granted.
model UserCapability {
  userId     String     @map("user_id") @db.Uuid
  capability Capability
  grantedAt  DateTime   @default(now()) @map("granted_at")
  grantedBy  String?    @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, capability])
  @@map("user_capabilities")
}

// Which version of which policy document a person accepted, and when.
//
// Deliberately not a boolean on User: a boolean cannot answer "did they agree to THIS version",
// which is the only question that matters when a document changes. Written in the same
// transaction as the account — a crash between the two leaves an account whose agreement has no
// record, and that is the one state here that cannot be repaired, because there is nothing to
// reconstruct it from.
model UserConsent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  documentKey String   @map("document_key")
  version     Int
  acceptedAt  DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentKey, version])
  @@index([userId])
  @@map("user_consents")
}

// Holds a date of birth and consent across the Google OAuth round trip.
//
// The alternative was carrying them in the OAuth `state` parameter, which travels in URLs and
// therefore lands in access logs, browser history and referrer headers. Only the opaque id of
// this row travels; the data stays server-side and the row is deleted once used.
//
// It also gives the SIGN-IN path a concrete test: no pending record and no existing account means
// somebody reached sign-in without signing up, which must not create anything.
model PendingSignup {
  id         String   @id @default(uuid()) @db.Uuid
  // Chosen by the person before they leave for Google, so their public identifier is theirs
  // rather than one derived from their email address without asking.
  username   String
  dob        DateTime @db.Date
  consents   Json
  language   Language @default(EN)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("pending_signups")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followeeId  String   @map("followee_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Following", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@map("user_follows")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  passwordHash      String?      @map("password_hash")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  // When the holder of THIS session last proved they are the account holder — by password, or by
  // signing in with Google again. Sensitive actions require it to be recent, and consume it.
  // On the session rather than the user so the proof cannot be spent from another browser (#196).
  reauthenticatedAt DateTime? @map("reauthenticated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  token     String           @unique
  type      VerificationType
  metadata  Json?
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Invitation {
  id           String            @id @default(uuid()) @db.Uuid
  inviterId    String            @map("inviter_id") @db.Uuid
  inviteeEmail String            @map("invitee_email")
  inviteeId    String?           @map("invitee_id") @db.Uuid
  type         InvitationType
  scopeId      String?           @map("scope_id") @db.Uuid // journey id if VM_JOURNEY
  token        String            @unique
  status       InvitationStatus  @default(PENDING)
  channel      InvitationChannel @default(IN_APP)
  invitedAt    DateTime          @default(now()) @map("invited_at")
  expiresAt    DateTime          @map("expires_at")
  acceptedAt   DateTime?         @map("accepted_at")
  reminderSentAt DateTime?       @map("reminder_sent_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  inviter User @relation("InvitationSender", fields: [inviterId], references: [id])

  @@index([inviterId])
  @@index([inviteeEmail])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════
// CONTENT — VIRTUES / WEAKNESSES / SENTENCES
// ═══════════════════════════════════════════════════

model Virtue {
  id          String   @id @default(uuid()) @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameMr      String?  @map("name_mr")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subvirtues Subvirtue[]

  @@map("virtues")
}

model Subvirtue {
  id          String   @id @default(uuid()) @db.Uuid
  virtueId    String   @map("virtue_id") @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameMr      String?  @map("name_mr")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  virtue    Virtue      @relation(fields: [virtueId], references: [id])
  sentences Sentence[]
  weaknesses WeaknessSubvirtue[]

  @@index([virtueId])
  @@map("subvirtues")
}

model Weakness {
  id          String   @id @default(uuid()) @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameMr      String?  @map("name_mr")
  category    String? // A, B, C
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subvirtues           WeaknessSubvirtue[]
  journeyWeaknesses    JourneyWeakness[]
  exposureWeaknesses   ExposureWeakness[]
  resolutionWeaknesses ResolutionWeakness[]
  challengeWeaknesses  ChallengeWeakness[]
  testAttempts         TestAttempt[]

  @@map("weaknesses")
}

model WeaknessSubvirtue {
  weaknessId  String @map("weakness_id") @db.Uuid
  subvirtueId String @map("subvirtue_id") @db.Uuid
  priority    Int    @default(0)

  weakness  Weakness  @relation(fields: [weaknessId], references: [id], onDelete: Cascade)
  subvirtue Subvirtue @relation(fields: [subvirtueId], references: [id], onDelete: Cascade)

  @@id([weaknessId, subvirtueId])
  @@map("weakness_subvirtues")
}

model Sentence {
  id          String   @id @default(uuid()) @db.Uuid
  subvirtueId String   @map("subvirtue_id") @db.Uuid
  textEn      String   @map("text_en")
  textMr      String?  @map("text_mr")
  sourceFile  String?  @map("source_file")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subvirtue   Subvirtue @relation(fields: [subvirtueId], references: [id])
  exposures   Exposure[]
  resolutions Resolution[]
  challenges  Challenge[]
  journeys    Journey[]

  @@index([subvirtueId])
  @@map("sentences")
}

// ═══════════════════════════════════════════════════
// ERC POOL (central content)
// ═══════════════════════════════════════════════════

model Exposure {
  id               String       @id @default(uuid()) @db.Uuid
  sentenceId       String       @map("sentence_id") @db.Uuid
  tier             ExposureTier
  titleEn          String       @map("title_en")
  titleMr          String?      @map("title_mr")
  descriptionEn    String?      @map("description_en")
  descriptionMr    String?      @map("description_mr")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  sentence          Sentence @relation(fields: [sentenceId], references: [id])
  weaknessTags      ExposureWeakness[]
  journeyExposures  JourneyExposure[]

  @@index([sentenceId])
  @@map("exposures")
}

model ExposureWeakness {
  exposureId  String @map("exposure_id") @db.Uuid
  weaknessId  String @map("weakness_id") @db.Uuid

  exposure Exposure @relation(fields: [exposureId], references: [id], onDelete: Cascade)
  weakness Weakness @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@id([exposureId, weaknessId])
  @@map("exposure_weaknesses")
}

model Resolution {
  id                String   @id @default(uuid()) @db.Uuid
  sentenceId        String   @map("sentence_id") @db.Uuid
  titleEn           String   @map("title_en")
  titleMr           String?  @map("title_mr")
  descriptionEn     String?  @map("description_en")
  descriptionMr     String?  @map("description_mr")
  durationWeeks     Int?     @map("duration_weeks")
  frequencyPerWeek  Int?     @map("frequency_per_week")
  frequencyLabel    String?  @map("frequency_label")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sentence            Sentence @relation(fields: [sentenceId], references: [id])
  weaknessTags        ResolutionWeakness[]
  journeyResolutions  JourneyResolution[]

  @@index([sentenceId])
  @@map("resolutions")
}

model ResolutionWeakness {
  resolutionId String @map("resolution_id") @db.Uuid
  weaknessId   String @map("weakness_id") @db.Uuid

  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  weakness   Weakness   @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@id([resolutionId, weaknessId])
  @@map("resolution_weaknesses")
}

model Challenge {
  id            String   @id @default(uuid()) @db.Uuid
  sentenceId    String   @map("sentence_id") @db.Uuid
  titleEn       String   @map("title_en")
  titleMr       String?  @map("title_mr")
  descriptionEn String?  @map("description_en")
  descriptionMr String?  @map("description_mr")
  durationDays  Int?     @map("duration_days")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sentence          Sentence @relation(fields: [sentenceId], references: [id])
  weaknessTags      ChallengeWeakness[]
  journeyChallenges JourneyChallenge[]

  @@index([sentenceId])
  @@map("challenges")
}

model ChallengeWeakness {
  challengeId String @map("challenge_id") @db.Uuid
  weaknessId  String @map("weakness_id") @db.Uuid

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  weakness  Weakness  @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@id([challengeId, weaknessId])
  @@map("challenge_weaknesses")
}

// ═══════════════════════════════════════════════════
// TESTS
// ═══════════════════════════════════════════════════

model TestAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  weaknessId  String    @map("weakness_id") @db.Uuid
  isDraft     Boolean   @default(true) @map("is_draft")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  answers  TestAnswer[]
  weakness Weakness @relation(fields: [weaknessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId, weaknessId])
  @@map("test_attempts")
}

model TestAnswer {
  id            String      @id @default(uuid()) @db.Uuid
  testAttemptId String      @map("test_attempt_id") @db.Uuid
  sentenceId    String      @map("sentence_id") @db.Uuid
  score         Int // 1=Never, 2=Sometimes, 3=Often, 4=Always
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)

  @@unique([testAttemptId, sentenceId])
  @@map("test_answers")
}

// ═══════════════════════════════════════════════════
// JOURNEYS
// ═══════════════════════════════════════════════════

model Journey {
  id            String       @id @default(uuid()) @db.Uuid
  vratarthiId   String       @map("vratarthi_id") @db.Uuid
  sentenceId    String       @map("sentence_id") @db.Uuid
  title         String
  state         JourneyState @default(NOT_STARTED)
  startedAt     DateTime?    @map("started_at")
  completionSubmittedAt DateTime? @map("completion_submitted_at")
  completedAt   DateTime?    @map("completed_at")
  dormantSince  DateTime?    @map("dormant_since")
  pausedAt      DateTime?    @map("paused_at")
  // Challenge suggestion threshold (overridable by VM)
  thresholdExposures  Int @default(1) @map("threshold_exposures")
  thresholdResolutions Int @default(1) @map("threshold_resolutions")
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  vratarthi        User                  @relation("VratarthiJourneys", fields: [vratarthiId], references: [id])
  sentence         Sentence              @relation(fields: [sentenceId], references: [id])
  weaknesses       JourneyWeakness[]
  vmAssignments    JourneyVmAssignment[]
  exposures        JourneyExposure[]
  resolutions      JourneyResolution[]
  challenges       JourneyChallenge[]
  experienceLogs   ExperienceLog[]
  chatMessages     ChatMessage[]

  @@index([vratarthiId])
  @@index([sentenceId])
  // Partial unique index enforcing "one live journey per (vratarthi, sentence)":
  // UNIQUE (vratarthi_id, sentence_id) WHERE deleted_at IS NULL AND state <> 'completed'.
  // Prisma can't express the WHERE predicate declaratively, so it lives in the migration
  // (journeys_vratarthi_sentence_live_key). Keep its predicate in sync with the blocking
  // states in JourneysRepository.findActiveForSentence.
  @@map("journeys")
}

model JourneyWeakness {
  journeyId  String @map("journey_id") @db.Uuid
  weaknessId String @map("weakness_id") @db.Uuid
  attachedAt DateTime @default(now()) @map("attached_at")

  journey  Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
