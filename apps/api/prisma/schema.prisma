generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════

enum Role {
  VRATARTHI  @map("vratarthi")
  VRATMITRA  @map("vratmitra")
  MODERATOR  @map("moderator")
  ADMIN      @map("admin")

  @@map("role")
}

enum Language {
  EN @map("en")
  MR @map("mr")

  @@map("language")
}

enum AuthProvider {
  EMAIL  @map("email")
  GOOGLE @map("google")

  @@map("auth_provider")
}

enum VerificationType {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")
  EMAIL_CHANGE       @map("email_change")
  GOOGLE_LINK        @map("google_link")

  @@map("verification_type")
}

enum JourneyState {
  NOT_STARTED @map("not_started")
  ACTIVE      @map("active")
  PAUSED      @map("paused")
  DORMANT     @map("dormant")
  COMPLETED   @map("completed")

  @@map("journey_state")
}

enum ErcStatus {
  NOT_STARTED @map("not_started")
  IN_PROGRESS @map("in_progress")
  SUBMITTED   @map("submitted")
  APPROVED    @map("approved")
  REVISIT     @map("revisit")

  @@map("erc_status")
}

enum ExposureTier {
  LOCAL         @map("local")
  NATIONAL      @map("national")
  INTERNATIONAL @map("international")

  @@map("exposure_tier")
}

enum InvitationType {
  PLATFORM   @map("platform")
  VM_GLOBAL  @map("vm_global")
  VM_JOURNEY @map("vm_journey")

  @@map("invitation_type")
}

enum InvitationStatus {
  PENDING   @map("pending")
  ACCEPTED  @map("accepted")
  DECLINED  @map("declined")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")

  @@map("invitation_status")
}

enum InvitationChannel {
  IN_APP   @map("in_app")
  EMAIL    @map("email")
  EXTERNAL @map("external")

  @@map("invitation_channel")
}

enum VmRelationshipState {
  PENDING @map("pending")
  ACTIVE  @map("active")

  @@map("vm_relationship_state")
}

enum CheckinStatus {
  DONE    @map("done")
  PARTIAL @map("partial")
  MISSED  @map("missed")

  @@map("checkin_status")
}

enum ExperienceVisibility {
  ONLY_ME @map("only_me")
  FRIENDS @map("friends")
  PUBLIC  @map("public")

  @@map("experience_visibility")
}

enum ErcEntityType {
  EXPOSURE   @map("exposure")
  RESOLUTION @map("resolution")
  CHALLENGE  @map("challenge")

  @@map("erc_entity_type")
}

enum ResourceType {
  FILE @map("file")
  LINK @map("link")

  @@map("resource_type")
}

enum TagEntityType {
  VIRTUE     @map("virtue")
  SUBVIRTUE  @map("subvirtue")
  WEAKNESS   @map("weakness")
  SENTENCE   @map("sentence")
  EXPOSURE   @map("exposure")
  RESOLUTION @map("resolution")
  CHALLENGE  @map("challenge")
  JOURNEY    @map("journey")

  @@map("tag_entity_type")
}

enum NotificationEventType {
  VM_INVITATION_RECEIVED       @map("vm_invitation_received")
  VM_INVITATION_ACCEPTED       @map("vm_invitation_accepted")
  VM_INVITATION_DECLINED       @map("vm_invitation_declined")
  VM_INVITATION_EXPIRED        @map("vm_invitation_expired")
  INVITEE_JOINED_PLATFORM      @map("invitee_joined_platform")
  JOURNEY_DORMANT              @map("journey_dormant")
  NEW_ERC_AVAILABLE            @map("new_erc_available")
  ERC_CLOSURE_SUBMITTED        @map("erc_closure_submitted")
  ERC_CLOSURE_APPROVED         @map("erc_closure_approved")
  ERC_RETURNED_FOR_REVISIT     @map("erc_returned_for_revisit")
  JOURNEY_COMPLETION_SUBMITTED @map("journey_completion_submitted")
  JOURNEY_COMPLETION_APPROVED  @map("journey_completion_approved")
  CUSTOM_ERC_REVIEW_REQUESTED  @map("custom_erc_review_requested")
  CUSTOM_ERC_APPROVED          @map("custom_erc_approved")
  CUSTOM_ERC_REJECTED          @map("custom_erc_rejected")
  VM_SUGGESTION_NEW            @map("vm_suggestion_new")
  VM_SUGGESTION_DISMISSED      @map("vm_suggestion_dismissed")
  BLOG_COMMENT_NEW             @map("blog_comment_new")
  COMMENT_REPORTED             @map("comment_reported")
  NEW_FOLLOWER                 @map("new_follower")
  CHAT_MESSAGE_RECEIVED        @map("chat_message_received")
  VM_WITHDREW                  @map("vm_withdrew")

  @@map("notification_event_type")
}

// ═══════════════════════════════════════════════════
// IDENTITY & AUTH
// ═══════════════════════════════════════════════════

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  displayName           String    @map("display_name")
  username              String    @unique
  avatarUrl             String?   @map("avatar_url")
  gender                String?
  dob                   DateTime? @db.Date
  language              Language  @default(EN)
  emailVerifiedAt       DateTime? @map("email_verified_at")
  accountSetupCompletedAt DateTime? @map("account_setup_completed_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  lastActiveAt          DateTime? @map("last_active_at")
  showLastActive        Boolean   @default(true) @map("show_last_active")
  showOnlineIndicator   Boolean   @default(true) @map("show_online_indicator")
  profilePrivate        Boolean   @default(false) @map("profile_private")
  // Per-field public-profile visibility (spec/10). Empty/missing key = visible
  // (all fields public by default). Only `false` entries hide a field.
  profileVisibility     Json      @default("{}") @map("profile_visibility")
  // Per-event email opt-out map (spec/25). Missing key = email enabled; only explicit
  // `false` opts out. Storage-only until notification email delivery is built.
  notificationPrefs     Json      @default("{}") @map("notification_prefs")
  // Address awaiting confirmation during an email-change flow (null when none pending).
  pendingEmail          String?   @map("pending_email")
  suspendedAt           DateTime? @map("suspended_at")
  anonymisedAt          DateTime? @map("anonymised_at")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  roles              UserRole[]
  authAccounts       AuthAccount[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  invitationsSent    Invitation[]          @relation("InvitationSender")
  followers          UserFollow[]          @relation("Following")
  following          UserFollow[]          @relation("Follower")
  notifications      Notification[]        @relation("NotificationRecipient")
  actorNotifications Notification[]        @relation("NotificationActor")
  journeys           Journey[]             @relation("VratarthiJourneys")
  testAttempts       TestAttempt[]
  globalVmFor        VmRelationship[]      @relation("GlobalVM")
  journeyVmFor       JourneyVmAssignment[] @relation("JourneyVM")
  experienceLogs     ExperienceLog[]
  blogs              Blog[]
  blogComments       BlogComment[]
  auditEvents        AuditEvent[]          @relation("AuditActor")
  chatMessages       ChatMessage[]
  uploads            Upload[]

  @@index([username])
  @@index([email])
  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followeeId  String   @map("followee_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Following", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@map("user_follows")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  passwordHash      String?      @map("password_hash")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  token     String           @unique
  type      VerificationType
  metadata  Json?
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Invitation {
  id           String            @id @default(uuid()) @db.Uuid
  inviterId    String            @map("inviter_id") @db.Uuid
  inviteeEmail String            @map("invitee_email")
  inviteeId    String?           @map("invitee_id") @db.Uuid
  type         InvitationType
  scopeId      String?           @map("scope_id") @db.Uuid // journey id if VM_JOURNEY
  token        String            @unique
  status       InvitationStatus  @default(PENDING)
  channel      InvitationChannel @default(IN_APP)
  invitedAt    DateTime          @default(now()) @map("invited_at")
  expiresAt    DateTime          @map("expires_at")
  acceptedAt   DateTime?         @map("accepted_at")
  reminderSentAt DateTime?       @map("reminder_sent_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  inviter User @relation("InvitationSender", fields: [inviterId], references: [id])

  @@index([inviterId])
  @@index([inviteeEmail])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════
// CONTENT — VIRTUES / WEAKNESSES / SENTENCES
// ═══════════════════════════════════════════════════

model Virtue {
  id          String   @id @default(uuid()) @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameMr      String?  @map("name_mr")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subvirtues Subvirtue[]

  @@map("virtues")
}

model Subvirtue {
  id          String   @id @default(uuid()) @db.Uuid
  virtueId    String   @map("virtue_id") @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameMr      String?  @map("name_mr")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  virtue    Virtue      @relation(fields: [virtueId], references: [id])
  sentences Sentence[]
  weaknesses WeaknessSubvirtue[]

  @@index([virtueId])
  @@map("subvirtues")
}

model Weakness {
  id          String   @id @default(uuid()) @db.Uuid
  nameEn      String   @unique @map("name_en")
  nameMr      String?  @map("name_mr")
  category    String? // A, B, C
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subvirtues           WeaknessSubvirtue[]
  journeyWeaknesses    JourneyWeakness[]
  exposureWeaknesses   ExposureWeakness[]
  resolutionWeaknesses ResolutionWeakness[]
  challengeWeaknesses  ChallengeWeakness[]
  testAttempts         TestAttempt[]

  @@map("weaknesses")
}

model WeaknessSubvirtue {
  weaknessId  String @map("weakness_id") @db.Uuid
  subvirtueId String @map("subvirtue_id") @db.Uuid
  priority    Int    @default(0)

  weakness  Weakness  @relation(fields: [weaknessId], references: [id], onDelete: Cascade)
  subvirtue Subvirtue @relation(fields: [subvirtueId], references: [id], onDelete: Cascade)

  @@id([weaknessId, subvirtueId])
  @@map("weakness_subvirtues")
}

model Sentence {
  id          String   @id @default(uuid()) @db.Uuid
  subvirtueId String   @map("subvirtue_id") @db.Uuid
  textEn      String   @map("text_en")
  textMr      String?  @map("text_mr")
  sourceFile  String?  @map("source_file")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subvirtue   Subvirtue @relation(fields: [subvirtueId], references: [id])
  exposures   Exposure[]
  resolutions Resolution[]
  challenges  Challenge[]
  journeys    Journey[]

  @@index([subvirtueId])
  @@map("sentences")
}

// ═══════════════════════════════════════════════════
// ERC POOL (central content)
// ═══════════════════════════════════════════════════

model Exposure {
  id               String       @id @default(uuid()) @db.Uuid
  sentenceId       String       @map("sentence_id") @db.Uuid
  tier             ExposureTier
  titleEn          String       @map("title_en")
  titleMr          String?      @map("title_mr")
  descriptionEn    String?      @map("description_en")
  descriptionMr    String?      @map("description_mr")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  sentence          Sentence @relation(fields: [sentenceId], references: [id])
  weaknessTags      ExposureWeakness[]
  journeyExposures  JourneyExposure[]

  @@index([sentenceId])
  @@map("exposures")
}

model ExposureWeakness {
  exposureId  String @map("exposure_id") @db.Uuid
  weaknessId  String @map("weakness_id") @db.Uuid

  exposure Exposure @relation(fields: [exposureId], references: [id], onDelete: Cascade)
  weakness Weakness @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@id([exposureId, weaknessId])
  @@map("exposure_weaknesses")
}

model Resolution {
  id                String   @id @default(uuid()) @db.Uuid
  sentenceId        String   @map("sentence_id") @db.Uuid
  titleEn           String   @map("title_en")
  titleMr           String?  @map("title_mr")
  descriptionEn     String?  @map("description_en")
  descriptionMr     String?  @map("description_mr")
  durationWeeks     Int?     @map("duration_weeks")
  frequencyPerWeek  Int?     @map("frequency_per_week")
  frequencyLabel    String?  @map("frequency_label")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sentence            Sentence @relation(fields: [sentenceId], references: [id])
  weaknessTags        ResolutionWeakness[]
  journeyResolutions  JourneyResolution[]

  @@index([sentenceId])
  @@map("resolutions")
}

model ResolutionWeakness {
  resolutionId String @map("resolution_id") @db.Uuid
  weaknessId   String @map("weakness_id") @db.Uuid

  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  weakness   Weakness   @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@id([resolutionId, weaknessId])
  @@map("resolution_weaknesses")
}

model Challenge {
  id            String   @id @default(uuid()) @db.Uuid
  sentenceId    String   @map("sentence_id") @db.Uuid
  titleEn       String   @map("title_en")
  titleMr       String?  @map("title_mr")
  descriptionEn String?  @map("description_en")
  descriptionMr String?  @map("description_mr")
  durationDays  Int?     @map("duration_days")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sentence          Sentence @relation(fields: [sentenceId], references: [id])
  weaknessTags      ChallengeWeakness[]
  journeyChallenges JourneyChallenge[]

  @@index([sentenceId])
  @@map("challenges")
}

model ChallengeWeakness {
  challengeId String @map("challenge_id") @db.Uuid
  weaknessId  String @map("weakness_id") @db.Uuid

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  weakness  Weakness  @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@id([challengeId, weaknessId])
  @@map("challenge_weaknesses")
}

// ═══════════════════════════════════════════════════
// TESTS
// ═══════════════════════════════════════════════════

model TestAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  weaknessId  String    @map("weakness_id") @db.Uuid
  isDraft     Boolean   @default(true) @map("is_draft")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  answers  TestAnswer[]
  weakness Weakness @relation(fields: [weaknessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId, weaknessId])
  @@map("test_attempts")
}

model TestAnswer {
  id            String      @id @default(uuid()) @db.Uuid
  testAttemptId String      @map("test_attempt_id") @db.Uuid
  sentenceId    String      @map("sentence_id") @db.Uuid
  score         Int // 1=Never, 2=Sometimes, 3=Often, 4=Always
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)

  @@unique([testAttemptId, sentenceId])
  @@map("test_answers")
}

// ═══════════════════════════════════════════════════
// JOURNEYS
// ═══════════════════════════════════════════════════

model Journey {
  id            String       @id @default(uuid()) @db.Uuid
  vratarthiId   String       @map("vratarthi_id") @db.Uuid
  sentenceId    String       @map("sentence_id") @db.Uuid
  title         String
  state         JourneyState @default(NOT_STARTED)
  startedAt     DateTime?    @map("started_at")
  completionSubmittedAt DateTime? @map("completion_submitted_at")
  completedAt   DateTime?    @map("completed_at")
  dormantSince  DateTime?    @map("dormant_since")
  pausedAt      DateTime?    @map("paused_at")
  // Challenge suggestion threshold (overridable by VM)
  thresholdExposures  Int @default(1) @map("threshold_exposures")
  thresholdResolutions Int @default(1) @map("threshold_resolutions")
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  vratarthi        User                  @relation("VratarthiJourneys", fields: [vratarthiId], references: [id])
  sentence         Sentence              @relation(fields: [sentenceId], references: [id])
  weaknesses       JourneyWeakness[]
  vmAssignments    JourneyVmAssignment[]
  exposures        JourneyExposure[]
  resolutions      JourneyResolution[]
  challenges       JourneyChallenge[]
  experienceLogs   ExperienceLog[]
  chatMessages     ChatMessage[]

  @@index([vratarthiId])
  @@index([sentenceId])
  @@map("journeys")
}

model JourneyWeakness {
  journeyId  String @map("journey_id") @db.Uuid
  weaknessId String @map("weakness_id") @db.Uuid
  attachedAt DateTime @default(now()) @map("attached_at")

  journey  Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  weakness Weakness @relation(fields: [weaknessId], references: [id])

  @@id([journeyId, weaknessId])
  @@map("journey_weaknesses")
}

model VmRelationship {
  id        String               @id @default(uuid()) @db.Uuid
  vratarthiId String             @map("vratarthi_id") @db.Uuid
  vmId       String              @map("vm_id") @db.Uuid
  state      VmRelationshipState @default(PENDING)
  acceptedAt DateTime?           @map("accepted_at")
  endedAt    DateTime?           @map("ended_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  // Global VM relationship (not journey-scoped)
  vm User @relation("GlobalVM", fields: [vmId], references: [id])

  @@index([vratarthiId])
  @@index([vmId])
  @@map("vm_relationships")
}

model JourneyVmAssignment {
  id        String               @id @default(uuid()) @db.Uuid
  journeyId String               @map("journey_id") @db.Uuid
  vmId      String               @map("vm_id") @db.Uuid
  state     VmRelationshipState  @default(PENDING)
  acceptedAt DateTime?           @map("accepted_at")
  endedAt   DateTime?            @map("ended_at")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  vm      User    @relation("JourneyVM", fields: [vmId], references: [id])

  @@index([journeyId])
  @@index([vmId])
  @@map("journey_vm_assignments")
}

// ═══════════════════════════════════════════════════
// JOURNEY ERC (instances selected/created per journey)
// ═══════════════════════════════════════════════════

model JourneyExposure {
  id              String    @id @default(uuid()) @db.Uuid
  journeyId       String    @map("journey_id") @db.Uuid
  poolExposureId  String?   @map("pool_exposure_id") @db.Uuid // null if custom
  isCustom        Boolean   @default(false) @map("is_custom")
  isDeactivated   Boolean   @default(false) @map("is_deactivated")
  status          ErcStatus @default(NOT_STARTED)
  // Custom fields (mirror pool or override)
  tier            ExposureTier
  titleEn         String    @map("title_en")
  titleMr         String?   @map("title_mr")
  descriptionEn   String?   @map("description_en")
  descriptionMr   String?   @map("description_mr")
  startedAt       DateTime? @map("started_at")
  submittedAt     DateTime? @map("submitted_at")
  approvedAt      DateTime? @map("approved_at")
  createdById     String?   @map("created_by_id") @db.Uuid // null for pool-sourced items
  // Submit-for-global-review
  reviewStatus    String?   @map("review_status") // pending/approved/rejected
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  journey          Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  poolExposure     Exposure?          @relation(fields: [poolExposureId], references: [id])
  vmSidenote       VmSidenote?
  customErcReviews CustomErcReview[]

  @@index([journeyId])
  @@map("journey_exposures")
}

model JourneyResolution {
  id               String    @id @default(uuid()) @db.Uuid
  journeyId        String    @map("journey_id") @db.Uuid
  poolResolutionId String?   @map("pool_resolution_id") @db.Uuid // null if custom
  isCustom         Boolean   @default(false) @map("is_custom")
  isDeactivated    Boolean   @default(false) @map("is_deactivated")
  status           ErcStatus @default(NOT_STARTED)
  // Custom/overridable fields
  titleEn          String    @map("title_en")
  titleMr          String?   @map("title_mr")
  descriptionEn    String?   @map("description_en")
  descriptionMr    String?   @map("description_mr")
  durationWeeks    Int?      @map("duration_weeks")
  frequencyPerWeek Int?      @map("frequency_per_week")
  frequencyLabel   String?   @map("frequency_label")
  startedAt        DateTime? @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  approvedAt       DateTime? @map("approved_at")
  createdById      String?   @map("created_by_id") @db.Uuid // null for pool-sourced items
  reviewStatus     String?   @map("review_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  journey          Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  poolResolution   Resolution?        @relation(fields: [poolResolutionId], references: [id])
  checkins         ResolutionCheckin[]
  vmSidenote       VmSidenote?
  customErcReviews CustomErcReview[]

  @@index([journeyId])
  @@map("journey_resolutions")
}

model ResolutionCheckin {
  id                  String        @id @default(uuid()) @db.Uuid
  journeyResolutionId String        @map("journey_resolution_id") @db.Uuid
  status              CheckinStatus
  note                String?
  checkedInAt         DateTime      @default(now()) @map("checked_in_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  journeyResolution JourneyResolution @relation(fields: [journeyResolutionId], references: [id], onDelete: Cascade)

  @@index([journeyResolutionId])
  @@map("resolution_checkins")
}

model JourneyChallenge {
  id               String    @id @default(uuid()) @db.Uuid
  journeyId        String    @map("journey_id") @db.Uuid
  poolChallengeId  String?   @map("pool_challenge_id") @db.Uuid // null if custom
  isCustom         Boolean   @default(false) @map("is_custom")
  isDeactivated    Boolean   @default(false) @map("is_deactivated")
  status           ErcStatus @default(NOT_STARTED)
  titleEn          String    @map("title_en")
  titleMr          String?   @map("title_mr")
  descriptionEn    String?   @map("description_en")
  descriptionMr    String?   @map("description_mr")
  durationDays     Int?      @map("duration_days")
  startedAt        DateTime? @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  approvedAt       DateTime? @map("approved_at")
  createdById      String?   @map("created_by_id") @db.Uuid // null for pool-sourced items
  reviewStatus     String?   @map("review_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  journey          Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  poolChallenge    Challenge?         @relation(fields: [poolChallengeId], references: [id])
  vmSidenote       VmSidenote?
  customErcReviews CustomErcReview[]

  @@index([journeyId])
  @@map("journey_challenges")
}

model CustomErcReview {
  id                  String        @id @default(uuid()) @db.Uuid
  entityType          ErcEntityType @map("entity_type")
  journeyExposureId   String?       @map("journey_exposure_id") @db.Uuid
  journeyResolutionId String?       @map("journey_resolution_id") @db.Uuid
  journeyChallengeId  String?       @map("journey_challenge_id") @db.Uuid
  submittedById       String        @map("submitted_by_id") @db.Uuid
  status              String        @default("pending") // pending/approved/rejected
  reviewedById        String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?     @map("reviewed_at")
  reviewNote          String?       @map("review_note")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  journeyExposure   JourneyExposure?   @relation(fields: [journeyExposureId], references: [id])
  journeyResolution JourneyResolution? @relation(fields: [journeyResolutionId], references: [id])
  journeyChallenge  JourneyChallenge?  @relation(fields: [journeyChallengeId], references: [id])

  @@map("custom_erc_reviews")
}

model VmSidenote {
  id                  String    @id @default(uuid()) @db.Uuid
  vmId                String    @map("vm_id") @db.Uuid
  entityType          ErcEntityType @map("entity_type")
  journeyExposureId   String?   @unique @map("journey_exposure_id") @db.Uuid
  journeyResolutionId String?   @unique @map("journey_resolution_id") @db.Uuid
  journeyChallengeId  String?   @unique @map("journey_challenge_id") @db.Uuid
  text                String
  acknowledgedAt      DateTime? @map("acknowledged_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  journeyExposure   JourneyExposure?   @relation(fields: [journeyExposureId], references: [id])
  journeyResolution JourneyResolution? @relation(fields: [journeyResolutionId], references: [id])
  journeyChallenge  JourneyChallenge?  @relation(fields: [journeyChallengeId], references: [id])

  @@map("vm_sidenotes")
}

// ═══════════════════════════════════════════════════
// EXPERIENCE LOGS & CHAT
// ═══════════════════════════════════════════════════

model ExperienceLog {
  id         String               @id @default(uuid()) @db.Uuid
  authorId   String               @map("author_id") @db.Uuid
  journeyId  String?              @map("journey_id") @db.Uuid
  body       Json                 // Tiptap JSON AST
  visibility ExperienceVisibility @default(ONLY_ME)
  isDraft    Boolean              @default(true) @map("is_draft")
  featured   Boolean              @default(false)
  publishedAt DateTime?           @map("published_at")
  deletedAt  DateTime?            @map("deleted_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  author  User     @relation(fields: [authorId], references: [id])
  journey Journey? @relation(fields: [journeyId], references: [id])
  tags    ExperienceLogTag[]

  @@index([authorId])
  @@index([featured])
  @@map("experience_logs")
}

model ExperienceLogTag {
  id               String        @id @default(uuid()) @db.Uuid
  experienceLogId  String        @map("experience_log_id") @db.Uuid
  entityType       TagEntityType @map("entity_type")
  entityId         String        @map("entity_id") @db.Uuid

  experienceLog ExperienceLog @relation(fields: [experienceLogId], references: [id], onDelete: Cascade)

  @@index([experienceLogId])
  @@map("experience_log_tags")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  journeyId String?  @map("journey_id") @db.Uuid // null = not journey-contextual
  roomId    String   @map("room_id") // format: "chat:userId1:userId2" sorted
  body      Json     // Tiptap JSON AST
  seqNo     Int      @map("seq_no") // per-room sequence number
  createdAt DateTime @default(now()) @map("created_at")

  sender  User     @relation(fields: [senderId], references: [id])
  journey Journey? @relation(fields: [journeyId], references: [id])

  @@index([roomId, seqNo])
  @@map("chat_messages")
}

// ═══════════════════════════════════════════════════
// UPLOADS (chat images, etc)
// ═══════════════════════════════════════════════════

model Upload {
  id        String   @id @default(uuid()) @db.Uuid
  uploaderId String  @map("uploader_id") @db.Uuid
  roomId    String?  @map("room_id") // Optional: associate with chat room
  minioUrl  String   @map("minio_url") // Public MinIO URL
  filename  String
  createdAt DateTime @default(now()) @map("created_at")

  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([uploaderId])
  @@index([roomId])
  @@map("uploads")
}

// ═══════════════════════════════════════════════════
// COMMUNITY — BLOGS
// ═══════════════════════════════════════════════════

model Blog {
  id          String    @id @default(uuid()) @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String
  body        Json      // Tiptap JSON AST
  isDraft     Boolean   @default(true) @map("is_draft")
  featured    Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id])
  comments BlogComment[]

  @@index([authorId])
  @@index([featured])
  @@map("blogs")
}

model BlogComment {
  id          String    @id @default(uuid()) @db.Uuid
  blogId      String    @map("blog_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid // reserved for future threading (v1: flat)
  body        String
  isHidden    Boolean   @default(false) @map("is_hidden")
  hiddenById  String?   @map("hidden_by_id") @db.Uuid
  reportedAt  DateTime? @map("reported_at") // flagged for moderator review
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([blogId])
  @@map("blog_comments")
}

// ═══════════════════════════════════════════════════
// CONTENT — POTHI / SHLOKAS / RESOURCES
// ═══════════════════════════════════════════════════

model Shloka {
  id             String   @id @default(uuid()) @db.Uuid
  devanagariText String   @map("devanagari_text")
  transliteration String?
  meaningEn      String?  @map("meaning_en")
  meaningMr      String?  @map("meaning_mr")
  sourceCitation String?  @map("source_citation")
  looseTags      String[] @map("loose_tags") // free-form text array
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  formalTags        ShlokaTag[]
  pothuSectionLinks PothiSectionShloka[]
  scheduleEntries   ShlokaSchedule[]
  queueItems        ShlokaQueueItem[]

  @@map("shlokas")
}

model ShlokaTag {
  id         String        @id @default(uuid()) @db.Uuid
  shlokaId   String        @map("shloka_id") @db.Uuid
  entityType TagEntityType @map("entity_type")
  entityId   String        @map("entity_id") @db.Uuid

  shloka Shloka @relation(fields: [shlokaId], references: [id], onDelete: Cascade)

  @@index([shlokaId])
  @@map("shloka_tags")
}

model PothiSection {
  id                    String   @id @default(uuid()) @db.Uuid
  sectionNumber         Int      @unique @map("section_number")
  titleEn               String   @map("title_en")
  titleMr               String?  @map("title_mr")
  introText             String?  @map("intro_text")
  congregationResponse  String?  @map("congregation_response")
  postShlokaCommentary  String?  @map("post_shloka_commentary")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  shlokas PothiSectionShloka[]

  @@map("pothi_sections")
}

model PothiSectionShloka {
  pothiSectionId String @map("pothi_section_id") @db.Uuid
  shlokaId       String @map("shloka_id") @db.Uuid
  sortOrder      Int    @default(0) @map("sort_order")

  pothiSection PothiSection @relation(fields: [pothiSectionId], references: [id], onDelete: Cascade)
  shloka       Shloka       @relation(fields: [shlokaId], references: [id])

  @@id([pothiSectionId, shlokaId])
  @@map("pothi_section_shlokas")
}

model ShlokaSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  shlokaId       String   @map("shloka_id") @db.Uuid
  scheduledDate  DateTime @unique @map("scheduled_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  shloka Shloka @relation(fields: [shlokaId], references: [id])

  @@map("shloka_schedules")
}

model ShlokaQueueItem {
  id        String   @id @default(uuid()) @db.Uuid
  shlokaId  String   @map("shloka_id") @db.Uuid
  position  Int      @unique
  createdAt DateTime @default(now()) @map("created_at")

  shloka Shloka @relation(fields: [shlokaId], references: [id])

  @@map("shloka_queue_items")
}

model Resource {
  id              String       @id @default(uuid()) @db.Uuid
  type            ResourceType
  url             String?
  filePath        String?      @map("file_path")
  thumbnailUrl    String?      @map("thumbnail_url")
  title           String
  oneLiner        String?      @map("one_liner")
  description     Json?        // Tiptap JSON AST
  looseTags       String[]     @map("loose_tags")
  createdById     String       @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  formalTags ResourceTag[]

  @@map("resources")
}

model ResourceTag {
  id         String        @id @default(uuid()) @db.Uuid
  resourceId String        @map("resource_id") @db.Uuid
  entityType TagEntityType @map("entity_type")
  entityId   String        @map("entity_id") @db.Uuid

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_tags")
}

// Editable, admin-managed explanatory copy rendered in the UI (modals, intros), keyed by a
// stable string. Bodies are Tiptap JSON ASTs.
model CmsPage {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  titleEn     String   @map("title_en")
  titleMr     String?  @map("title_mr")
  bodyEn      Json     @map("body_en")
  bodyMr      Json?    @map("body_mr")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

// ═══════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════

model Notification {
  id            String                @id @default(uuid()) @db.Uuid
  recipientId   String                @map("recipient_id") @db.Uuid
  actorId       String?               @map("actor_id") @db.Uuid
  eventType     NotificationEventType @map("event_type")
  resourceType  String?               @map("resource_type")
  resourceId    String?               @map("resource_id") @db.Uuid
  readAt        DateTime?             @map("read_at")
  dismissedAt   DateTime?             @map("dismissed_at")
  archivedAt    DateTime?             @map("archived_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([recipientId, readAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════
// AUDIT
// ═══════════════════════════════════════════════════

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   // e.g. "admin.override_journey_state"
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?    // action-specific context
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}
