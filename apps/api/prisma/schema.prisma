// ═══════════════════════════════════════════════════
// UPLOADS (chat images, etc)
// ═══════════════════════════════════════════════════

model Upload {
  id        String   @id @default(uuid()) @db.Uuid
  uploaderId String  @map("uploader_id") @db.Uuid
  roomId    String?  @map("room_id") // Optional: associate with chat room
  storageKey String  @map("storage_key") // Object key, e.g. "<uuid>.png". Never a URL — the
  // visibility policy decides how a key becomes a URL, and that decision must stay changeable.
  // What the upload is FOR decides who may see it. Persisted because the resolver endpoint is
  // handed only a key and must not have to guess.
  purpose   UploadPurpose @default(EXPERIENCE)
  filename  String
  createdAt DateTime @default(now()) @map("created_at")

  // The document this image belongs to, once one exists. Visibility derives from it: the
  // resolver asks the log the same question the app asks, rather than reimplementing the rule.
  // Null while composing, and permanently if the log is never saved — an orphan, readable only
  // by whoever uploaded it.
  experienceLogId String? @map("experience_log_id") @db.Uuid

  uploader      User           @relation(fields: [uploaderId], references: [id])
  experienceLog ExperienceLog? @relation(fields: [experienceLogId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([roomId])
  @@index([storageKey])
  @@index([experienceLogId])
  @@map("uploads")
}

