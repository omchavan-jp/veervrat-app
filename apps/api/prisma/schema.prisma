  @@map("notifications")
}

// ═══════════════════════════════════════════════════
// FEEDBACK (beta observations widget)
// ═══════════════════════════════════════════════════

model FeedbackItem {
  id           String         @id @default(uuid()) @db.Uuid
  reporterId   String         @map("reporter_id") @db.Uuid
  // Role snapshot at report time — the reporter's roles can change later.
  reporterRole String         @map("reporter_role")
  type         FeedbackType
  status       FeedbackStatus @default(NEW)
  title        String
  description  String?
  // Client-supplied diagnostics (validated + length-capped, never trusted for authz)
  route         String?
  locale        String?
  viewport      String?
  userAgent     String?  @map("user_agent")
  commitSha     String?  @map("commit_sha")
  declineReason String?  @map("decline_reason")
  // Required when marking DONE — mirrors declineReason's required-on-DECLINED pattern.
  doneNote      String?  @map("done_note")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reporter User             @relation("FeedbackReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  upvotes  FeedbackUpvote[]

  @@index([status, createdAt])
  @@map("feedback_items")
}

model FeedbackUpvote {
  id             String   @id @default(uuid()) @db.Uuid
  feedbackItemId String   @map("feedback_item_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  feedbackItem FeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)
  user         User         @relation("FeedbackUpvoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackItemId, userId])
  @@map("feedback_upvotes")
}

// ═══════════════════════════════════════════════════
// AUDIT
// ═══════════════════════════════════════════════════

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   // e.g. "admin.override_journey_state"
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?    // action-specific context
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

// ─── Content suggestions ───────────────────────────────────────────────────────
// Someone who knows what the content should say, saying it in the place it belongs.
// Feedback captures which page but never where on it; the content editor can only edit what is
// already a CmsPage. A suggestion is the frontier case: propose content that does not exist yet.
// See openspec/changes/content-suggestions/.

enum SuggestionKind {
  ADD_SECTION @map("add_section")
  EDIT_COPY   @map("edit_copy")
  ADD_FIELD   @map("add_field")
  REMOVE      @map("remove")
  NOTE        @map("note")

  @@map("suggestion_kind")
}

enum SuggestionStatus {
  NEW      @map("new")
  TRIAGED  @map("triaged")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  // Distinct from ACCEPTED on purpose: "we agreed" and "it is live" are different facts, and
  // collapsing them is how a register comes to claim work that has not shipped.
  SHIPPED  @map("shipped")

  @@map("suggestion_status")
}

model ContentSuggestion {
  id       String           @id @default(uuid()) @db.Uuid
  authorId String           @map("author_id") @db.Uuid
  kind     SuggestionKind
  status   SuggestionStatus @default(NEW)

  // Where it was made. Captured by the picker, never typed.
  //
  // Four signals, ordered by how well they survive the page changing. A reader resolves an
  // anchor by trying anchorKey, then anchorText within the route, then anchorPath. When all
  // three miss, entityType + entityId + route still say which thing on which page — which is
  // enough to act on. anchorPath is recorded because it is free and sometimes exact; nothing
  // may be built that assumes it resolves.
  route      String // the PATTERN, e.g. /weaknesses/[id] — not the resolved URL
  url        String // the resolved URL, for going back to the exact page
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  locale     String // which language the author was reading when they wrote it
  anchorKey  String? @map("anchor_key")
  anchorText String? @map("anchor_text")
  anchorPath String? @map("anchor_path")
  viewport   String?

  // What they propose. Bilingual, in the shape CmsPage already stores.
  titleEn     String  @map("title_en")
  titleMr     String? @map("title_mr")
  bodyEn      Json?   @map("body_en")
  bodyMr      Json?   @map("body_mr")
  currentText String? @map("current_text") // what was there, for EDIT_COPY

  // Where it went. Triage ends in a conversion, not a bare status.
  resolution   String?
  linkedIssue  String? @map("linked_issue")
  linkedCmsKey String? @map("linked_cms_key")
  triagedById  String? @map("triaged_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Matches FeedbackItem: a deleted account takes its suggestions with it. An accepted
  // suggestion has already become a CmsPage, which does not cascade.
  author User @relation("SuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([entityType, entityId])
  @@index([route])
  @@index([authorId])
  @@map("content_suggestions")
}
